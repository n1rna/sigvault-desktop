{
	"project": "sigvault-desktop",
	"origins": {
		"github": {
			"type": "github",
			"mode": "bundled",
			"secret_name": "ENV_VARS_DESKTOP",
			"repo": "n1rna/sigvault-desktop",
			"environment": "development"
		}
	},
	"schema": {
		"variables": {
			"TAURI_SIGNING_PRIVATE_KEY": {
				"name": "TAURI_SIGNING_PRIVATE_KEY",
				"title": "Tauri updater signing private key (Ed25519)",
				"type": "string",
				"required": false,
				"secret": true
			},
			"TAURI_SIGNING_PRIVATE_KEY_PASSWORD": {
				"name": "TAURI_SIGNING_PRIVATE_KEY_PASSWORD",
				"title": "Tauri updater signing key password",
				"type": "string",
				"required": false,
				"secret": true
			}
		}
	},
	"environments": {
		"development": {
			"sheets": []
		}
	}
}
