# OAuth 2.0 Configuration
# These values should be obtained from your OAuth provider (Auth0, Okta, etc.)

# Your OAuth client ID (not secret - this is safe to expose in native apps)
OAUTH2_CLIENT_ID=your-client-id-here

# The authorization URL from your OAuth provider
OAUTH2_AUTH_URL=https://your-domain.auth0.com/authorize

# The token exchange URL from your OAuth provider
OAUTH2_TOKEN_URL=https://your-domain.auth0.com/oauth/token

# Note: Native applications should NOT use a client secret
# The PKCE flow provides security without requiring secrets
