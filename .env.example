# Sigvault Desktop — build-time configuration
#
# `.env` at the repo root is NOT needed to run the app. OAuth client IDs and
# token URLs are per-environment and live in `BUILTIN_OAUTH_CLIENTS` in
# `src-tauri/src/env_config/mod.rs`, resolved at runtime from whichever
# environment the user selects. `bun run tauri dev` works from a clean clone.
#
# The only variables that still matter at build time are the Tauri updater
# signing keys, and only when producing signed release artifacts. CI gets them
# from the `ENV_VARS_DESKTOP` GitHub secret, which the private
# `sigvault-secrets` repo owns (projects/desktop/development.env) and pushes
# here; `.ee.desktop` in this repo is the schema only, never the values.
#
# To produce a signed build locally, export these in your shell (the Tauri CLI
# reads the process environment — it does not read this file):
#
#   export TAURI_SIGNING_PRIVATE_KEY=...
#   export TAURI_SIGNING_PRIVATE_KEY_PASSWORD=...
#
# With the `ee` CLI and access to the secrets repo:
#
#   cd /path/to/sigvault-secrets/projects/desktop
#   eval "$(ee apply development --dry-run --format dotenv | sed 's/^/export /')"
#
# Note: API_BASE_URL and BITCOIN_NETWORK are not compile-time vars either. The
# app fetches the available environments at runtime from
# https://sigvault.org/environments.json and lets the user pick one before
# logging in.

TAURI_SIGNING_PRIVATE_KEY=
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
