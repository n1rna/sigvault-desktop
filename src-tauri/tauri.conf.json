{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "sigvault-desktop",
  "version": "0.0.0-dev",
  "identifier": "org.sigvault.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "sigvault-desktop",
        "width": 900,
        "height": 650,
        "minWidth": 750,
        "minHeight": 500,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhCNUY3MkJEQTAyNThFQTYKUldTbWppV2d2WEpmaTlYd2xxVkVrd0dvOWFPQ1BseFRzYnZ1OVFIb1hiQnhTcmtUTzBsSk1rTk4K",
      "endpoints": [
        "https://github.com/n1rna/sigvault-desktop/releases/latest/download/latest.json"
      ]
    }
  }
}
